<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h2>Photo Gallery</h2>
    <div class="gallery">
        <% images.forEach(img => { %>
            <img src="/<%= img %>" alt="Photo" width="200" />
        <% }) %>
    </div>
    
</body>
</html>